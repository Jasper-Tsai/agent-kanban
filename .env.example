# Copy this file to .env, set the required secrets, and keep .env private.
# Values containing dollar signs must remain single-quoted for Compose.

# Host port published by Docker Compose and application port inside the container.
KANBAN_HOST_PORT=3600
PORT=3600

# Local application data directory. Docker Compose overrides this to /app/data.
KANBAN_DATA_DIR=./data

# Password hash: node scripts/hash-password.mjs
KANBAN_PASSWORD_HASH=''

# Session signing secret: openssl rand -hex 32
KANBAN_SESSION_SECRET=

# Optional agent tokens. Generate one token per client:
# node scripts/gen-token.mjs codex
# node scripts/gen-token.mjs claude
# Store only the SHA-256 entries here; keep the plain tokens in client configuration.
KANBAN_API_TOKENS=

# Server timezone for scheduled work and server-generated date labels.
KANBAN_TIMEZONE=UTC

# Set to 1 only behind a trusted reverse proxy that provides client-address headers.
KANBAN_TRUST_PROXY=0

# Secure cookies are enabled by default. For local plain-HTTP debugging only:
# KANBAN_COOKIE_SECURE=0

